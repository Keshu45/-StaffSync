# ========================================================
# StaffSync HRMS — Environment Configuration
# ========================================================

# Application Port (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local Instance)
# Leave empty to run with resilient seeded in-memory database store
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/staffsync?retryWrites=true&w=majority

# JSON Web Token Secret Key for signing session tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=staffsync-super-secret-jwt-key-2025-secure-token

# JWT Session Expiration (e.g., '7d', '24h', '30m')
JWT_EXPIRES_IN=7d

# CORS Allowed Client Origin (for separate backend deployments)
CLIENT_URL=http://localhost:3000

# Authentication Cookie Name
COOKIE_NAME=staffsync_token

# Optional: Frontend API URL (if frontend is hosted on a separate domain, e.g. Vercel)
# VITE_API_URL=https://your-staffsync-api.onrender.com/api
